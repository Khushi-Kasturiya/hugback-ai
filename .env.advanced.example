# Advanced/legacy reference ONLY. Do not copy wholesale over a working .env.
# For the synthetic workflow start from .env.example and the testing runbook.
# Production feature flags are incompatible with isolated Firestore test mode.
# Hugback AI Backend Environment Variables

# --- Option A: Gemini API Key (Recommended for Quick Local Development) ---
# Paste your Gemini API key from https://aistudio.google.com/app/apikey here:
GEMINI_API_KEY=

# --- Option B: Google Cloud Vertex AI (Using ADC) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=project-84a7c715-3d60-4253-acb
GOOGLE_CLOUD_LOCATION=us-central1

# Model & Voice Settings
HUGBACK_MODEL=gemini-3.8-live
HUGBACK_VOICE_NAME=Aoede
HUGBACK_TTS_MODEL=gemini-3.8-flash-lite-tts
# 48..280 characters for the initial phrase; following phrases retain 280.
HUGBACK_TTS_FIRST_PHRASE_CHARS=96
# One queued phrase may synthesize ahead. More responsive between phrases,
# but interruptions may discard already-billed synthesis. Set 0 for serial.
HUGBACK_TTS_LOOKAHEAD=1
# Local child portal Voices API -> streaming TTS. Defaults off.
# Enable only for your authorized local test. Upload requires adult own-voice
# acknowledgement + spoken consent; Google usage can incur charges.
# Requires development auth, loopback Origin/peer, GEMINI_API_KEY and preset Live mode.
HUGBACK_REPLICATED_TTS_ENABLED=FALSE
# Temporary provider keys only; no audio. This path is offline SQLite only.
# HUGBACK_DEMO_STORE=firestore selects the backend-only Firestore vault instead.
# HUGBACK_VOICE_DB_PATH=/absolute/private/local-voice/voices.sqlite3
# Ordinary calls use only the configured preset. Stale browser uploads are
# rejected, not silently substituted. experimental-inline is operator research
# only: requires both recordings and server consent acknowledgement; no fallback.
HUGBACK_LIVE_VOICE_MODE=preset

# Optional private file paths for scripts/check_live_voice_replication.py.
# Configuring paths does not enable custom voice in calls or upload recordings.
# Leave unset unless running the isolated, offline-by-default voice check.
# HUGBACK_VOICE_REFERENCE_PATH=/absolute/private/reference-24khz-mono.wav
# HUGBACK_VOICE_CONSENT_PATH=/absolute/private/consent-24khz-mono.wav
# HUGBACK_VOICE_TEST_OUTPUT_PATH=/absolute/private/live-replication-new-result.wav
# The separate check_tts_voice_replication.py also reads the reference/consent
# paths and GEMINI_API_KEY, but requires an explicit --output path.
# API usage belongs to the key's project, not the browser's signed-in account.

# --- Identity ---
# Use development locally. Use firebase for every deployed environment.
HUGBACK_AUTH_MODE=development
FIREBASE_PROJECT_ID=

# --- Long-term memory ---
# Run scripts/create_memory_bank.py once, then paste the printed resource name.
MEMORY_ENABLED=FALSE
MEMORY_BANK_NAME=
MEMORY_INITIAL_LIMIT=5
MEMORY_SEARCH_LIMIT=3
MEMORY_CONTEXT_MAX_CHARS=4000

# Store the real transcript and processing state in Firestore.
FIRESTORE_ENABLED=FALSE

# Read-only child-portal shared updates. Requires verified Firebase identity,
# trusted parent linkage and an exact-content parent approval producer.
# Those enrollment/production flows are not wired by the local portal patch.
# A development browser UUID NEVER reads a private cloud mailbox.
PORTAL_SHARING_ENABLED=FALSE
FIRESTORE_DATABASE=(default)

# Internal Forms/Drive intake storage. OFF unless an operator explicitly enables
# an existing Firestore database + private Cloud Storage bucket. No web API,
# automatic Drive scan, resource provisioning, Firebase login or local fallback.
# Run scripts/import_chat_original.py without --execute for offline validation.
# Source originals remain stored after processing; no application TTL/delete.
CLOUD_INTAKE_ENABLED=FALSE
# Dedicated existing bucket name only (3–63 chars, no dots, gs:// or object path).
# Require uniform bucket-level access, enforced public access prevention, and
# no lifecycle Delete rules. Configure ADC for the operator/service account.
CLOUD_IMPORT_BUCKET=
# See docs/CLOUD_INTAKE.md before enabling; flags never grant participant consent.

# Synthetic-only local hackathon demo; set TRUE only on your local backend.
# Requires development identity + actual loopback peer + local frontend Origin.
# No cloud database, resource creation or real-family consent is implied.
# Schema v2: one family, up to eight separate recipients; no new flag is needed.
# Each context edit/call requires an owner-validated recipient ID and revision.
# A shared child voice never shares the recipients' memory or consent.
LOCAL_DEMO_ENABLED=FALSE
# Optional absolute local path; default is backend/.local-demo/hugback.sqlite3.
# LOCAL_DEMO_DB_PATH=/absolute/private/local-demo/hugback.sqlite3
# Demo calls use standard Live audio unless an enabled owner TTS profile is
# explicitly assigned to that recipient. Enablement alone does not assign it.
# Replacement/expiry/removal blocks stale assignments; reassign or choose standard.
# TTS discards Live preset audio; it is not a Live voice ID.
# Keep MEMORY_ENABLED, FIRESTORE_ENABLED and FOLLOWUPS_ENABLED FALSE for this demo.

# Canonical wellbeing follow-up pilot. OFF until explicit cloud authorization,
# verified parent identity, versioned wellbeing-memory consent and provider tests.
# These flags alone DO NOT grant per-parent consent.
# Canonical mode bypasses legacy Memory Bank and raw transcript persistence.
FOLLOWUPS_ENABLED=FALSE
FOLLOWUP_EXTRACTION_MODEL=gemini-3.8-flash
# Conversational scheduling/eligibility defaults, NOT medical thresholds.
FOLLOWUP_COOLDOWN_HOURS=24
FOLLOWUP_RETENTION_HOURS=72

# Local: inline. Cloud Run: cloud_tasks.
MEMORY_PROCESSING_MODE=inline
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=hugback-memory
MEMORY_PROCESSOR_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
# Local-only shared secret. Prefer Cloud Run IAM + OIDC in production.
MEMORY_TASK_SECRET=

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
