# Live Google test storage; OFF until explicit resource/billing authorization.
# Needs an EXISTING isolated test project and named database, ADC, suitable IAM,
# Firebase anonymous auth, frontend Firebase API configuration, and owner allowlist.
# No resource provisioning or production data migration is performed by this app.
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=firestore
FIRESTORE_ENABLED=TRUE
HUGBACK_DEMO_PROJECT=
HUGBACK_DEMO_DATABASE=hugback-synthetic
FIREBASE_PROJECT_ID=
HUGBACK_AUTH_MODE=firebase
HUGBACK_CLOUD_TEST_ENABLED=FALSE
HUGBACK_TEST_OWNER_UIDS=
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE
HUGBACK_WORKFLOW_ENABLED=FALSE
# FIRESTORE_EMULATOR_HOST must be UNSET for live storage.
# The original LOCAL_DEMO_DB_PATH and private voice database are NOT migrated.
