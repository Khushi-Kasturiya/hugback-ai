# Live Google test storage; OFF until explicit resource/billing authorization.
# Needs an EXISTING isolated test project and named database, ADC, suitable IAM,
# Firebase anonymous auth, frontend Firebase API configuration, and owner allowlist.
# No resource provisioning or production data migration is performed by this app.
# Frontend and backend stay local; only the selected synthetic store is in Google.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=firestore
FIRESTORE_ENABLED=TRUE
HUGBACK_DEMO_PROJECT=
HUGBACK_DEMO_DATABASE=hugback-synthetic
FIREBASE_PROJECT_ID=
HUGBACK_AUTH_MODE=firebase
HUGBACK_CLOUD_TEST_ENABLED=FALSE
# Local browser/backend using cloud storage does not enable remote requests.
HUGBACK_REMOTE_TEST_ENABLED=FALSE
HUGBACK_REMOTE_TEST_ORIGIN=
HUGBACK_PUBLIC_DEMO_ENABLED=FALSE
HUGBACK_TEST_OWNER_UIDS=
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE
HUGBACK_WORKFLOW_ENABLED=FALSE
# Storage checks must not send email or enroll/upload a voice.
HUGBACK_ALERT_EMAIL_ENABLED=FALSE
HUGBACK_REPLICATED_TTS_ENABLED=FALSE
# After backend-only rules verification, enable both flags for explicit enrollment.
# Family AND voice keys then use the named Firestore DB, never local SQLite.
HUGBACK_FIRESTORE_VOICE_RULES_CONFIRMED=FALSE
# FIRESTORE_EMULATOR_HOST must be UNSET for live storage.
# The original LOCAL_DEMO_DB_PATH and private voice database are NOT migrated.
# gcloud login and backend ADC are distinct credentials. For your own account:
#   gcloud auth login --update-adc --project=YOUR_EXISTING_PROJECT
# Never copy another person's service-account key or put credentials in this file.
