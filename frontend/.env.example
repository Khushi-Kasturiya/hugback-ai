# Local simulator: leave Firebase unset to use a loopback development identity.
NEXT_PUBLIC_HUGBACK_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_HUGBACK_WS_URL=ws://127.0.0.1:8000/ws
NEXT_PUBLIC_HUGBACK_DEMO_MODE=true
# Only for explicitly authorized cloud synthetic test mode. This identifies the
# Firebase project, NOT a backend credential or a participant consent grant.
# Explicitly empty so a local production build cannot inherit the hosted key.
NEXT_PUBLIC_FIREBASE_API_KEY=
# No Gemini API keys or service-account credentials belong in this file.
