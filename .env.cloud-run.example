# Proposed settings for the operator's existing SYNTHETIC Cloud Run test.
# Public synthetic demo, explicitly approved 18 October. NOT a real-family service.
# Read docs/CLOUD_RUN_CONFIGURATION_AUDIT.md before applying anything.
# This is dotenv reference syntax, NOT a gcloud --env-vars-file YAML file.
# No provisioning, migration, deployment, paid checks or live email are performed
# by copying this file. It stays secret-free; the hackathon-only local-source
# deployment instead embeds the private, Git-ignored `.env` in its image.

# Reference placeholder only. Put the rotated credential in the private `.env`
# for the approved hackathon shortcut; use Secret Manager after the event.
GEMINI_API_KEY=
# Firestore uses the attached Cloud Run service identity independently of
# Gemini model authentication.

# These are the repository's configured IDs, NOT verified project entitlements.
HUGBACK_MODEL=gemini-3.8-live
FOLLOWUP_EXTRACTION_MODEL=gemini-3.8-flash
HUGBACK_CALL_SUMMARY_MODEL=gemini-3.5-flash-lite
HUGBACK_TTS_MODEL=gemini-3.8-flash-lite-tts
HUGBACK_VOICE_NAME=Aoede
HUGBACK_LIVE_VOICE_MODE=preset
# Both standard Live and owner-selected replicated TTS are supported.
HUGBACK_REPLICATED_TTS_ENABLED=TRUE
# Verified 18 October 2026 in Firebase Console: the active rules on the named
# hugback-synthetic database deny every browser read and write.
HUGBACK_FIRESTORE_VOICE_RULES_CONFIRMED=TRUE

HUGBACK_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=project-84a7c715-3d60-4253-acb
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=firestore
FIRESTORE_ENABLED=TRUE
FIRESTORE_DATABASE=hugback-synthetic
HUGBACK_DEMO_PROJECT=project-84a7c715-3d60-4253-acb
HUGBACK_DEMO_DATABASE=hugback-synthetic
HUGBACK_CLOUD_TEST_ENABLED=TRUE
# Separate opt-in for remote HTTP/WebSocket access. No wildcard or URL path.
HUGBACK_REMOTE_TEST_ENABLED=TRUE
HUGBACK_REMOTE_TEST_ORIGIN=https://hugback.cloud.run
# Permit verified anonymous Firebase visitors without manual UID approval.
# Anyone with the URL can use paid demo calls; URL secrecy is NOT an access gate.
HUGBACK_PUBLIC_DEMO_ENABLED=TRUE
# Allows configured localhost origins as well as the hosted HTTPS origin for a
# frictionless judge walkthrough. Keep CORS_ORIGINS explicit; never use '*'.
HUGBACK_JUDGE_DEMO_ENABLED=TRUE
# Optional only while PUBLIC_DEMO is true. Required in restricted remote mode.
HUGBACK_TEST_OWNER_UIDS=
HUGBACK_WORKFLOW_ENABLED=TRUE
# Extract bounded, source-linked interests, people and conversation style for
# recipient-scoped continuity. Calls receive only a small relevant selection.
HUGBACK_CONTEXT_EXTRACTION_ENABLED=TRUE
# Leave FIRESTORE_EMULATOR_HOST unset for the existing named cloud database.

# Correct for the synthetic repository; do NOT enable legacy production paths.
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
# cloud_tasks only handles the legacy path, not the synthetic four-stage flow.
MEMORY_PROCESSING_MODE=inline

# Email the bounded generated call summary to the owner-entered family address.
# For the hackathon build, set both values only in the private, ignored `.env`.
# Never commit them; rotate and migrate them to Secret Manager after the event.
HUGBACK_ALERT_EMAIL_ENABLED=TRUE
HUGBACK_ALERT_SMTP_USERNAME=
HUGBACK_ALERT_SMTP_APP_PASSWORD=
HUGBACK_PORTAL_URL=https://hugback.cloud.run/childportal

# Cloud Run injects PORT; the current backend image listens on 8080.
HOST=0.0.0.0
PORT=8080
# Exact FRONTEND origin, no path, wildcard, Markdown or backend URL.
CORS_ORIGINS=https://hugback.cloud.run
LOG_LEVEL=INFO
