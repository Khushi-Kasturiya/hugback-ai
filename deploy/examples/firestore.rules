// UNDEPLOYED EXAMPLE: dedicated server-only intake database.
// Do not overwrite another application's rules with this file.
// Admin/server SDKs bypass these client rules; enforce least-privilege IAM too.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
