# Public Firebase Web API key. Anonymous Authentication must be enabled in
# Firebase Console by an authorized operator. If omitted, Hugback uses a
# development browser UUID on localhost ONLY. No sign-in screen is shown.
# Match backend HUGBACK_AUTH_MODE=firebase and FIREBASE_PROJECT_ID when configured.
# This key is a public web config value, not a Gemini/service-account secret.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Local browser + local backend + cloud Firestore:
# use ws://127.0.0.1:8000/ws here, not the hosted backend.
# A cloud Firestore database does not require a cloud HTTP/WebSocket endpoint.
NEXT_PUBLIC_HUGBACK_WS_URL=

# Matching local HTTP override: http://127.0.0.1:8000.
# Otherwise derived from WS URL or :8000.
NEXT_PUBLIC_HUGBACK_API_URL=

# Keep true for the local synthetic recipient/workflow UI.
# false selects the separate non-demo call path, not Firestore family mode.
# This flag grants no backend access. Hosted mode needs separate backend flags,
# verified Firebase authentication, an exact HTTPS origin and named Firestore.
NEXT_PUBLIC_HUGBACK_DEMO_MODE=true

# Synthetic hackathon mode is enabled on the backend (LOCAL_DEMO_ENABLED=TRUE),
# not by a public browser role flag. Leave Firebase unset ONLY for the offline
# SQLite/emulator development-identity mode. Live synthetic Firestore REQUIRES
# the matching Firebase Web API key and a server-allowlisted Firebase browser UID.
# /childportal is internal setup; /?demo=parent&recipient=<id> is the call test.
# Select a server-issued family recipient explicitly; the URL is not authority.
# Mother/Father keep separate context; the enabled child voice is assigned per person.
# Product setup remains Forms/Drive; this is not a product dashboard rollout.
# Voice setup uses these same HTTP/WS URLs and the selected browser identity.
# Leave voice enrollment disabled during a Firestore-only connection check.
# Enable HUGBACK_REPLICATED_TTS_ENABLED on the backend, not in public config.
# In Firestore mode, keys/profile metadata use the same named database. Verify
# deny-all browser rules before HUGBACK_FIRESTORE_VOICE_RULES_CONFIRMED=TRUE.
# Never put a Gemini API key or provider voice key in a NEXT_PUBLIC variable.
