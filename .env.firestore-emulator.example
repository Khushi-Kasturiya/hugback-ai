# Overlay these deliberately onto local settings. Emulator must already run.
# No Google storage credentials or live Firebase auth are used for this mode.
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=firestore
FIRESTORE_ENABLED=TRUE
HUGBACK_DEMO_PROJECT=demo-hugback
HUGBACK_DEMO_DATABASE=hugback-synthetic
HUGBACK_AUTH_MODE=development
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
HUGBACK_CLOUD_TEST_ENABLED=FALSE
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE
HUGBACK_WORKFLOW_ENABLED=FALSE
