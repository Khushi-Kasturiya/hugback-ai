# Elara AI Backend Environment Variables

# --- Option A: Gemini API Key (Recommended for Quick Local Development) ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Option B: Google Cloud Vertex AI (Using ADC) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=project-84a7c715-3d60-4253-acb
GOOGLE_CLOUD_LOCATION=us-central1

# Model & Voice Settings
# IMPORTANT: Only Live API models work here (they support bidiGenerateContent).
# Options: gemini-3.8-live, gemini-2.5-flash-native-audio-preview-12-2025
ELARA_MODEL=gemini-3.8-live
ELARA_VOICE_NAME=Aoede

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
