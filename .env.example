# Local synthetic simulator. Copy intentionally; never overwrite an existing .env.
# Server credentials only. Do not put them in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

HUGBACK_MODEL=gemini-3.8-live
HUGBACK_VOICE_NAME=Aoede
FOLLOWUP_EXTRACTION_MODEL=gemini-3.8-flash
HUGBACK_TTS_MODEL=gemini-3.8-flash-lite-tts
# Smaller initial phrase; then normal batching. Lookahead overlaps one queued
# phrase (may incur unused synthesis on interruption); 0 restores serial TTS.
HUGBACK_TTS_FIRST_PHRASE_CHARS=96
HUGBACK_TTS_LOOKAHEAD=1
HUGBACK_LIVE_VOICE_MODE=preset
# Separate explicit recording/upload action is still required; paid Google I/O.
HUGBACK_REPLICATED_TTS_ENABLED=FALSE

HUGBACK_AUTH_MODE=development
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=sqlite
# Planner + Memory Reconciler + Live + Critic. Adds paid structured calls only
# after the operator acknowledges fictional workflow processing and starts a call.
HUGBACK_WORKFLOW_ENABLED=FALSE
FIRESTORE_ENABLED=FALSE
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Retention/cooldowns keep code defaults. See .env.advanced.example for legacy
# and operator-only options, and docs/END_TO_END_TESTING.md for cloud test mode.
