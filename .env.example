# Local synthetic simulator. Copy intentionally; never overwrite an existing .env.
# Server credentials only. Do not put them in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=

HUGBACK_MODEL=gemini-3.8-live
# One Google Live preset for every standard-voice call. Changing this needs a backend restart;
# the name is pinned when a call opens, not switched during a conversation.
HUGBACK_VOICE_NAME=Aoede
FOLLOWUP_EXTRACTION_MODEL=gemini-3.8-flash
# Separate post-call summary model; one paid structured request per eligible call.
HUGBACK_CALL_SUMMARY_MODEL=gemini-3.5-flash-lite
HUGBACK_TTS_MODEL=gemini-3.8-flash-lite-tts
# Smaller initial phrase; then normal batching. Lookahead overlaps one queued
# phrase (may incur unused synthesis on interruption); 0 restores serial TTS.
HUGBACK_TTS_FIRST_PHRASE_CHARS=96
HUGBACK_TTS_LOOKAHEAD=1
# Live waits this long after silence before treating the parent's speech as done.
# 1000ms is an unhurried default; larger values add response latency.
HUGBACK_END_OF_SPEECH_SILENCE_MS=1300
HUGBACK_LIVE_VOICE_MODE=preset
# Separate explicit recording/upload action is still required; paid Google I/O.
HUGBACK_REPLICATED_TTS_ENABLED=FALSE

HUGBACK_AUTH_MODE=development
LOCAL_DEMO_ENABLED=TRUE
HUGBACK_DEMO_STORE=sqlite
# Off by default. Hosted demo configuration is in .env.cloud-run.example.
HUGBACK_REMOTE_TEST_ENABLED=FALSE
HUGBACK_REMOTE_TEST_ORIGIN=
HUGBACK_PUBLIC_DEMO_ENABLED=FALSE
# Enable only after verifying deny-all browser rules on the named database.
HUGBACK_FIRESTORE_VOICE_RULES_CONFIRMED=FALSE
# Future fictional call transcripts are saved only after per-recipient simulated
# standing sharing consent in Family setup. No env flag enables real-call history.
# Planner + Memory Reconciler + Live + Critic. Adds paid structured calls only
# after the operator acknowledges fictional workflow processing and starts a call.
HUGBACK_WORKFLOW_ENABLED=FALSE
# Optional fictional-call notices. Keep sender credentials in private .env.
# The authenticated family supplies its notification inbox in Family setup.
# Backend responses expose only a masked hint; no fallback recipient is used.
# Never paste the Gmail app password in source control or the browser.
# Check safely with: .venv/bin/python -m app.alerts.smoke_test
# Send one generic probe only when ready: add --send --to ADDRESS.
HUGBACK_ALERT_EMAIL_ENABLED=FALSE
HUGBACK_ALERT_SMTP_USERNAME=
HUGBACK_ALERT_SMTP_APP_PASSWORD=
FIRESTORE_ENABLED=FALSE
MEMORY_ENABLED=FALSE
FOLLOWUPS_ENABLED=FALSE
PORTAL_SHARING_ENABLED=FALSE
CLOUD_INTAKE_ENABLED=FALSE

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hugback.cloud.run
LOG_LEVEL=INFO
# Retention/cooldowns keep code defaults. See .env.advanced.example for legacy
# and operator-only options, and docs/END_TO_END_TESTING.md for cloud test mode.
